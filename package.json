{
  "name": "teamspace",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "dev": "vite --config web/vite.config.js --host 127.0.0.1",
    "start": "node api/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:admin-browser": "node tests/admin-browser.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "5.2.1",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.3.0"
  }
}
