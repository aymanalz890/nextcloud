# Set to the exact browser URL before deployment (no trailing slash).
UI_ORIGIN=http://YOUR-VM-PUBLIC-IP:8081
# Public HTTP is for disposable demo accounts/files only.
UI_BIND_ADDRESS=0.0.0.0
COOKIE_SECURE=false
NEXTCLOUD_IMAGE=nextcloud:33-apache
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NEXTCLOUD_ADMIN_USER=ncadmin
